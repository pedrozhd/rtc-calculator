# URLs dos backends oficiais (sem barra no final). Copie para .env.local.
# Regime regular: opcional; o padrão é a API pública da Receita.
# REGIME_REGULAR_API_URL=https://piloto-cbs.tributos.gov.br/servico/calculadora-consumo/api

# Valores abaixo valem para `docker compose -f backends/docker-compose.yml up`.
SIMPLES_NACIONAL_API_URL=http://localhost:8082/api
DANFSE_API_URL=http://localhost:8081/api
